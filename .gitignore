# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — ACEest Fitness & Gym DevOps Project
# ─────────────────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Database files (never commit runtime databases)
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Docker
*.tar
*.tar.gz

# Jenkins
.jenkins/

# SonarQube
.sonar/
.scannerwork/

# Secrets — NEVER commit these
*.env
.env
.env.local
secrets.yaml
kubeconfig.yaml
